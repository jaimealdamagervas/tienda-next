# Plantilla de variables de la web. Copia este archivo como .env.local y rellena los valores.
# En producción (Vercel) añade TODAS estas variables en Settings -> Environment Variables.
# Nunca subas el .env.local real a GitHub.

# URL de la API Express, terminada en /api (en producción, la de Render)
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL de esta web (en producción, la de Vercel)
NEXTAUTH_URL=http://localhost:3000
# Cadena larga y aleatoria. Para generar una:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Google OAuth: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized JavaScript origins: http://localhost:3000 (y la URL de Vercel)
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google (y lo mismo con Vercel)
# El Client ID también va en el .env de tienda-api.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Stripe (modo test): dashboard.stripe.com -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
